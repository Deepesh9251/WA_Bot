# ──────────────────────────────────────────────────────────────────
# WhatsApp Link Deleter Bot — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is in .gitignore.
# ──────────────────────────────────────────────────────────────────

# Telegram Bot Token — create a bot via @BotFather on Telegram
# Steps: open Telegram → search @BotFather → /newbot → follow prompts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your personal numeric Telegram Chat ID — the bot will DM you at this ID
# Steps: open Telegram → search @myidbot → /getid → copy the number
TELEGRAM_CHAT_ID=123456789

# Healthchecks.io ping URL — unique per check you create on healthchecks.io
# Steps: go to healthchecks.io → Add Check → Period=10min → copy the ping URL
HEALTHCHECK_PING_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# WhatsApp Group ID to monitor (e.g. 1234567890-1234567890@g.us or 1234567890@g.us)
# Leave blank on FIRST RUN — the bot will print all group IDs and exit,
# so you can find the right one. Then set it here and restart.
TARGET_GROUP_ID=
